Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid 10 m
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 20
      Color: 70; 70; 76
      Offset: {X: 60, Y: 0, Z: -2.46}
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 4
      Frames:
        All Enabled: false
        lidar_tc: {Value: true}
        ego: {Value: true}
        delphi_esr_radar: {Value: true}
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Ground (Patchwork++)
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /perception/ground_debug/ground
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 138; 104; 70
      Alpha: 0.35
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Non-ground
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /perception/ground_debug/nonground
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 196; 198; 206
      Alpha: 0.85
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Existing pipeline (fusion_node, green)
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /yolo/fused_bbox_markers
      Namespaces: {}
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: New detector + Patchwork++ (blue)
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/measurements/camera_lidar_markers
      Namespaces: {}
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Radar returns (range reference, orange)
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/measurements/radar_markers
      Namespaces: {}
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Aggregator tracks (+ velocity arrows)
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/objects_markers
      Namespaces: {}
      Value: false
    - Class: rviz_default_plugins/Image
      Name: Camera (YOLO)
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /yolo/dbg_image
      Normalize Range: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 24; 28
    Fixed Frame: lidar_tc
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 40
      Focal Point: {X: 38, Y: -4, Z: -1.5}
      Pitch: 0.52
      Yaw: 3.1416
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 1050
  Width: 1900
  X: 10
  Y: 10
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Camera (YOLO):
    collapsed: false
