<?xml version="1.0"?>
<package format="3">
  <name>sam2_ros</name>
  <version>0.0.0</version>
  <description>Road segmentation using SAM2 (ROS2 migration)</description>

  <maintainer email="parimi@tamu.edu">avalocal</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>ros2_numpy</exec_depend>

  <exec_depend>sam2_msgs</exec_depend>
  <exec_depend>perception_common</exec_depend>

  <export>
    <build_type>ament_python</build_type>
