FROM nvidia/cuda:12.6.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV ROS_DISTRO=jazzy
ENV PATH="/root/.local/bin:${PATH}"

SHELL ["/bin/bash", "-lc"]

RUN apt-get update && apt-get install -y \
    curl \
    gnupg2 \
    lsb-release \
    locales \
    wget \
    git \
    ca-certificates \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    python3-argcomplete \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    ffmpeg \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y \
            ros-jazzy-ros-base \
      ros-dev-tools \
            ros-jazzy-ament-package \
            ros-jazzy-ament-cmake-python \
            ros-jazzy-rmw-zenoh-cpp \
            ros-jazzy-ament-cmake-auto \
            ros-jazzy-cv-bridge \
            ros-jazzy-geometry-msgs \
            ros-jazzy-sensor-msgs \
            ros-jazzy-sensor-msgs-py \
            ros-jazzy-std-msgs \
            ros-jazzy-vision-msgs \
            ros-jazzy-image-transport \
            ros-jazzy-compressed-image-transport \
            ros-jazzy-message-filters \
            ros-jazzy-tf-transformations \
      python3-colcon-common-extensions \
      python3-rosdep \
      && rm -rf /var/lib/apt/lists/*

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi && rosdep update

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

WORKDIR /root/ws

COPY src/SAM3_ROS_NODE /root/ws/src/SAM3_ROS_NODE

# Normalize upstream SAM3_ROS_NODE layout for reproducible ROS entrypoint install.
RUN set -e && \
    cd /root/ws/src/SAM3_ROS_NODE && \
    mkdir -p scripts && \
    cat > scripts/segmentation_node <<'EOF'
#!/usr/bin/env python3
from sam3_ros.segmentation import main

if __name__ == "__main__":
    main()
EOF

RUN set -e && \
    cd /root/ws/src/SAM3_ROS_NODE && \
    mkdir -p scripts && \
    cat > scripts/sam3_mask_transform_node <<'EOF'
#!/usr/bin/env python3
from sam3_ros.sam3_mask_transform import main

if __name__ == "__main__":
    main()
EOF

# The workspace defaults this image used to patch in (use_compressed_image=False,
# a road text_prompt, and the camera topic) are now declared parameters carrying
# those values in-source, so there is nothing left to rewrite here.
RUN set -e && \
    cd /root/ws/src/SAM3_ROS_NODE && \
    chmod +x scripts/segmentation_node scripts/sam3_mask_transform_node && \
    sed -i '/src\/sam3_ros\/pub_test_image.py/d' CMakeLists.txt

# This layer pulls ~3GB of CUDA wheels plus a git checkout of SAM3, and on a link
# that stalls mid-transfer both fetchers give up well before the transfer would have
# recovered — seen as `operation timed out` from uv and `RPC failed / early EOF` from
# git. Both need a stall window, not more retries. Placed here rather than with the
# other ENVs so it cannot invalidate the cached apt layers above.
ENV UV_HTTP_TIMEOUT=180
ENV GIT_HTTP_LOW_SPEED_LIMIT=1000
ENV GIT_HTTP_LOW_SPEED_TIME=120
# HTTP/2 multiplexing is what truncates the SAM3 pack on this uplink ("RPC failed;
# curl 56" then "early EOF"); HTTP/1.1 transfers it intact. Set through the
# environment so it applies to the clone uv runs on its own.
ENV GIT_CONFIG_COUNT=1
ENV GIT_CONFIG_KEY_0=http.version
ENV GIT_CONFIG_VALUE_0=HTTP/1.1

RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    cd /root/ws/src/SAM3_ROS_NODE && \
    uv sync && \
    git clone --depth 1 --branch jazzy https://github.com/Box-Robotics/ros2_numpy.git /tmp/ros2_numpy && \
    cp -r /tmp/ros2_numpy/ros2_numpy /root/ws/src/SAM3_ROS_NODE/.venv/lib/python3.12/site-packages/ && \
    rm -rf /tmp/ros2_numpy && \
    uv run python -c "import cv2, cv_bridge, geometry_msgs.msg, sensor_msgs.msg, std_msgs.msg, vision_msgs.msg, torch" && \
    cd /root/ws && \
    colcon build --symlink-install

ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp


RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc && \
    echo "source /root/ws/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]