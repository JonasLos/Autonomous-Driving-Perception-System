FROM nvidia/cuda:12.6.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV ROS_DISTRO=jazzy
ENV PATH="/root/.local/bin:${PATH}"

SHELL ["/bin/bash", "-lc"]

RUN apt-get update && apt-get install -y \
    curl \
    gnupg2 \
    lsb-release \
    locales \
    wget \
    git \
    ca-certificates \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    python3-argcomplete \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    ffmpeg \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y \
            ros-jazzy-ros-base \
      ros-dev-tools \
            ros-jazzy-ament-package \
            ros-jazzy-rmw-zenoh-cpp \
            ros-jazzy-ament-cmake-auto \
            ros-jazzy-cv-bridge \
            ros-jazzy-geometry-msgs \
            ros-jazzy-sensor-msgs \
            ros-jazzy-std-msgs \
            ros-jazzy-vision-msgs \
            ros-jazzy-image-transport \
            ros-jazzy-compressed-image-transport \
      python3-colcon-common-extensions \
      python3-rosdep \
      && rm -rf /var/lib/apt/lists/*

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi && rosdep update

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

WORKDIR /root/ws

COPY src/SAM3_ROS_NODE /root/ws/src/SAM3_ROS_NODE

# Normalize upstream SAM3_ROS_NODE layout for reproducible ROS entrypoint install.
RUN set -e && \
    cd /root/ws/src/SAM3_ROS_NODE && \
    mkdir -p scripts && \
    cat > scripts/segmentation_node <<'EOF'
#!/usr/bin/env python3
from sam3_ros.segmentation import main

if __name__ == "__main__":
    main()
EOF

RUN set -e && \
    cd /root/ws/src/SAM3_ROS_NODE && \
    chmod +x scripts/segmentation_node && \
    sed -i '/src\/sam3_ros\/pub_test_image.py/d' CMakeLists.txt && \
    python3 - <<'PY'
from pathlib import Path

seg = Path("src/sam3_ros/segmentation.py")
text = seg.read_text()
text = text.replace('self.declare_parameter("use_compressed_image", True)', 'self.declare_parameter("use_compressed_image", False)')
text = text.replace('self.declare_parameter("text_prompt", "")', 'self.declare_parameter("text_prompt", "road")')
text = text.replace('"image",\n                self._image_callback,', '"/camera_fl/image_color",\n                self._image_callback,')
seg.write_text(text)
PY

RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    cd /root/ws/src/SAM3_ROS_NODE && \
    uv sync && \
    uv run python -c "import cv2, cv_bridge, geometry_msgs.msg, sensor_msgs.msg, std_msgs.msg, vision_msgs.msg, torch" && \
    cd /root/ws && \
    colcon build --symlink-install

ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp


RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc && \
    echo "source /root/ws/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]