FROM perception-base:latest

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace/Autonomous-Driving-Perception-System
COPY . .

RUN python3 -m venv /opt/transform_venv && \
    /opt/transform_venv/bin/pip install --upgrade pip && \
    /opt/transform_venv/bin/pip install "numpy<2" pyyaml torch cython transforms3d

# Install ros2_numpy from source to avoid numpy compatibility issues
RUN git clone --depth 1 --branch jazzy https://github.com/Box-Robotics/ros2_numpy.git /tmp/ros2_numpy && \
    cp -r /tmp/ros2_numpy/ros2_numpy /opt/transform_venv/lib/python3.12/site-packages/ && \
    rm -rf /tmp/ros2_numpy

RUN apt-get update && \
    apt-get install -y --no-install-recommends ros-jazzy-tf-transformations && \
    rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y || true

RUN source /opt/ros/jazzy/setup.bash && \
    colcon build --merge-install || true

CMD ["bash", "-c", "source /opt/ros/jazzy/setup.bash && \
    source install/setup.bash && \
    export PATH=/opt/transform_venv/bin:$PATH && \
    export PYTHONPATH=/opt/transform_venv/lib/python3.12/site-packages:$PYTHONPATH && \
    export PYTHONPATH=/workspace/Autonomous-Driving-Perception-System:$PYTHONPATH && \
    python src/transform.py"]
