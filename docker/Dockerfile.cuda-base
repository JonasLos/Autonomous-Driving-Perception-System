# Base image for GPU-accelerated ROS 2 Jazzy perception nodes
FROM nvidia/cuda:12.6.1-devel-ubuntu24.04

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp

# 1. Install base OS dependencies and ROS 2 Jazzy
RUN apt-get update && apt-get install -y \
    locales \
    curl \
    wget \
    git \
    nano \
    vim \
    sudo \
    gnupg2 \
    lsb-release \
    software-properties-common \
    build-essential \
    cmake \
    # Add ROS 2 GPG key
 && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    # Add ROS 2 repository
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null \
    # Install ROS 2, Python tools, and Zenoh RMW
 && apt-get update && apt-get install -y \
    ros-jazzy-ros-base \
    python3-pip \
    python3-venv \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    ros-jazzy-rmw-zenoh-cpp \
 && locale-gen en_US.UTF-8 \
 && rm -rf /var/lib/apt/lists/*

# 2. Initialize rosdep
RUN rosdep init && \
    rosdep update --rosdistro jazzy

# 3. Create a virtual environment and install modern Python tools
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip uv

# Set up ROS environment and activate venv
COPY ./docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
