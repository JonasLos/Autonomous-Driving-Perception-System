# Stage 1: Builder
# Compiles the SparseTransformer CUDA extension against a modern toolchain.
FROM perception-cuda-base:latest AS builder

ARG DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace/Autonomous-Driving-Perception-System

# Copy only the necessary source for building the extension
COPY ./src/sphereformer_ros/src/SphereFormer/third_party/SparseTransformer /tmp/SparseTransformer
COPY ./src/sphereformer_ros/requirements-sphereformer.txt /tmp/

# Install build dependencies and compile the extension in the venv
# This stage is designed to fail fast if the CUDA extension porting is not viable.
RUN source /opt/venv/bin/activate && \
    uv pip install -r /tmp/requirements-sphereformer.txt setuptools && \
    cd /tmp/SparseTransformer && \
    export TORCH_CUDA_ARCH_LIST="8.6;9.0+PTX" && \
    python3 setup.py install

# Stage 2: Runtime
# Creates the final, smaller runtime image.
FROM perception-cuda-base:latest

WORKDIR /workspace/Autonomous-Driving-Perception-System
COPY . .

# Install Python dependencies using uv for speed
RUN source /opt/venv/bin/activate && \
    uv pip install -r src/sphereformer_ros/requirements-sphereformer.txt

# pyg-lib, deliberately here rather than in requirements-sphereformer.txt.
#
# SparseTransformer calls torch_geometric's voxel_grid, which as of torch-geometric 2.8 is
# gated on `WITH_GRID_CLUSTER = hasattr(pyg_lib.ops, 'grid_cluster')` (typing.py:66). The
# torch-cluster fallback that used to satisfy it was removed, so torch_cluster being installed
# and importable no longer helps -- nothing consults it, and the node dies at its first
# forward pass with "voxel_grid requires pyg-lib>=0.6.0".
#
# It lives in stage 2 because requirements-sphereformer.txt is an input to the builder stage:
# editing that file invalidates the SparseTransformer CUDA compile for a package the compile
# does not need. pyg-lib is a runtime dependency of the node, not a build dependency of sptr.
RUN source /opt/venv/bin/activate && \
    uv pip install pyg-lib -f https://data.pyg.org/whl/torch-2.11.0+cu130.html

# Copy the compiled extension from the builder stage
COPY --from=builder /opt/venv/lib/python3.12/site-packages/sptr* /opt/venv/lib/python3.12/site-packages/

# Build the ROS 2 workspace, failing on any error
RUN apt-get update && \
    . /opt/ros/jazzy/setup.bash && \
    . /opt/venv/bin/activate && \
    rosdep install --from-paths src/perception_common src/sphereformer_ros --ignore-src -r -y --rosdistro jazzy --skip-keys "ament_python" && \
    rm -rf build install log && \
    colcon build --packages-select perception_common sphereformer_ros

# Set up the entrypoint
CMD ["bash", "-c", "source install/setup.bash && ros2 launch sphereformer_ros sphereformer_ros.launch.py"]
