FROM perception-base:latest

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace/Autonomous-Driving-Perception-System
RUN mkdir -p src
COPY src/Custom_YOLO_ROS ./src/Custom_YOLO_ROS
COPY src/perception_common ./src/perception_common

RUN rm -rf build install log && \
    python3 -m venv /opt/yolo_venv && \
    /opt/yolo_venv/bin/pip install --upgrade pip && \
    if [ -f src/Custom_YOLO_ROS/requirements.txt ]; then \
        /opt/yolo_venv/bin/pip install -r src/Custom_YOLO_ROS/requirements.txt; \
    fi && \
    /opt/yolo_venv/bin/pip install "numpy<2" ultralytics lap empy

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ros-jazzy-ament-cmake \
        ros-jazzy-cv-bridge \
        ros-jazzy-message-filters \
        ros-jazzy-rosidl-default-generators \
        ros-jazzy-std-srvs \
        ros-jazzy-tf2-ros \
        ros-jazzy-vision-msgs && \
    rosdep update && \
    rosdep install \
        --from-paths \
            src/Custom_YOLO_ROS/src/yolo_ros/yolo_msgs \
            src/Custom_YOLO_ROS/src/yolo_ros/yolo_ros \
            src/Custom_YOLO_ROS/src/yolo_ros/yolo_bringup \
        --ignore-src -r -y && \
    rm -rf /var/lib/apt/lists/*

RUN source /opt/ros/jazzy/setup.bash && \
    colcon build --merge-install --packages-select yolo_msgs yolo_ros yolo_bringup

# Set RMW_IMPLEMENTATION to use zenoh by default
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp

CMD ["bash", "-c", "source /opt/ros/jazzy/setup.bash && \
    source /workspace/Autonomous-Driving-Perception-System/install/setup.bash && \
    export PATH=/opt/yolo_venv/bin:$PATH && \
    export PYTHONPATH=/opt/yolo_venv/lib/python3.12/site-packages:$PYTHONPATH && \
    export PYTHONPATH=/workspace/Autonomous-Driving-Perception-System:$PYTHONPATH && \
    ros2 launch yolo_bringup yolov9.launch.py"]